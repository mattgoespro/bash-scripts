{
  "[shellcheckrc]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true
  },
  "[shellscript]": {
    "editor.defaultFormatter": "mads-hartmann.bash-ide-vscode",
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true
  },
  "bashIde.backgroundAnalysisMaxFiles": 50000,
  "bashIde.globPattern": "**/*.sh",
  "bashIde.shellcheckArguments": "--rcfile .shellcheckrc",
  "editor.codeActionsOnSave": {
    "source.fixAll.shellcheck": "always"
  },
  "editor.fontFamily": "Ubuntu Sans Mono",
  "editor.fontSize": 11,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "[Cursor Dark]": {
      "textMateRules": [
        {
          "scope": [
            "source.shell comment",
            "punctuation.definition.comment.shell",
            "punctuation.definition.comment.shebang.shell"
          ],
          "settings": {
            "foreground": "#828282"
          }
        },
        {
          "scope": [
            "variable.other.assignment.shell",
            "variable.other.normal.shell",
            "variable.parameter.positional.shell",
            "variable.parameter.positional.all.shell",
            "punctuation.definition.variable.shell"
          ],
          "settings": {
            "foreground": "#dec0ff"
          }
        },
        {
          "scope": [
            "string",
            "string.quoted.double.shell",
            "string.quoted.single.shell",
            "string.quoted.backtick.shell",
            "string.quoted.single.shell",
            "string.quoted.double.shell",
            "string.quoted.single.shell",
            "string.quoted.backtick.shell",
            "string.quoted.single.shell",
            "string.quoted.double.shell"
          ],
          "settings": {
            "foreground": "#dad79e"
          }
        }
      ]
    }
  },
  "files.eol": "\n",
  "gitProjectManager.baseProjectsFolders": [
    "%USERPROFILE%\\Desktop\\Code"
  ],
  "gitProjectManager.maxDepthRecursion": 2,
  "gitProjectManager.openInNewWindow": true,
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "workbench.activityBar.orientation": "vertical",
  "workbench.colorTheme": "Cursor Dark"
}