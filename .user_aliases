# shellcheck disable=SC2148
LOCALAPPDATA="$(cygpath "${LOCALAPPDATA:?}")"

alias env="env | sort"

if command -v sdkmanager.bat >/dev/null 2>&1; then
    alias sdkmanager="\"\$(command -v sdkmanager.bat)\""
fi

if command -v avdmanager.bat >/dev/null 2>&1; then
    alias avdmanager="\$(command -v avdmanager.bat)"
fi

alias cursor-cli="cursor agent"
alias agent="$LOCALAPPDATA/cursor-agent/agent.cmd"
